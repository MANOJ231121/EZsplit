# ==================================================
# EzSplit Environment Configuration
# ==================================================

# MongoDB Atlas or Local Connection String
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ezsplit?retryWrites=true&w=majority

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret key (HS256 requires at least 256 bits / 32 chars)
JWT_SECRET=EzSplitSecretKeyForJWTGenerationThatIsAtLeast256BitsLongForHS256Algorithm9876543210

# Backend Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ezsplit.vercel.app

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
